# Salin ke /etc/hermes-office.env di AWS. Isi nilai asli hanya di server.
HOST=127.0.0.1
PORT=8787
OFFICE_ORIGINS=http://localhost:5173
OFFICE_PASSWORD=
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
OFFICE_DB_PATH=/var/lib/hermes-office/office.sqlite
OFFICE_COOKIE_SECURE=true
OFFICE_TASK_TIMEOUT_MS=1800000
# OAuth opsional. Untuk lokal: http://localhost:8787
OFFICE_PUBLIC_URL=https://api.rage.ai.id
# 32 byte acak dalam 64 karakter hex; simpan hanya pada server.
OFFICE_VAULT_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
